{$ESCAPEBOT_DOMAIN} {
    encode zstd gzip
    reverse_proxy app:8080

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy same-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    request_body {
        max_size 10MB
    }
}
