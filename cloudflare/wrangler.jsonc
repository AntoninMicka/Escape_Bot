{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "escape-bot-cf-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/ws"
    ]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SESSIONS",
        "class_name": "GameSession"
      },
      {
        "name": "EVENTS",
        "class_name": "EventCoordinator"
      }
    ]
  },
  "exports": {
    "GameSession": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "EventCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "APP_ENV": "local",
    "GAME_DURATION_MINUTES": "165",
    "DEADLINE_PENALTY": "100"
  },
  "env": {
    "development": {
      "name": "escape-bot-cf-development",
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_SESSIONS",
            "class_name": "GameSession"
          },
          {
            "name": "EVENTS",
            "class_name": "EventCoordinator"
          }
        ]
      },
      "vars": {
        "APP_ENV": "development",
        "GAME_DURATION_MINUTES": "165",
        "DEADLINE_PENALTY": "100"
      }
    },
    "staging": {
      "name": "escape-bot-cf-staging",
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_SESSIONS",
            "class_name": "GameSession"
          },
          {
            "name": "EVENTS",
            "class_name": "EventCoordinator"
          }
        ]
      },
      "vars": {
        "APP_ENV": "staging",
        "GAME_DURATION_MINUTES": "165",
        "DEADLINE_PENALTY": "100"
      }
    },
    "production": {
      "name": "escape-bot-cf-production",
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_SESSIONS",
            "class_name": "GameSession"
          },
          {
            "name": "EVENTS",
            "class_name": "EventCoordinator"
          }
        ]
      },
      "vars": {
        "APP_ENV": "production",
        "GAME_DURATION_MINUTES": "165",
        "DEADLINE_PENALTY": "100"
      }
    }
  }
}
